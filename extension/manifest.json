{
  "manifest_version": 3,
  "name": "Tacet",
  "version": "0.1.0",
  "description": "Mira watches the work you do on the sites you turn her on for, learns what she cannot yet explain, and asks one question at a pause.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Tacet",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
