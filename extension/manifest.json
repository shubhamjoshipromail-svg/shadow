{
  "manifest_version": 3,
  "name": "Tacet",
  "version": "0.1.0",
  "description": "Mira watches the work you do on the sites you turn her on for, learns what she cannot yet explain, and asks one question at a pause.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "store/icon16.png",
    "32": "store/icon32.png",
    "48": "store/icon48.png",
    "128": "store/icon128.png"
  },
  "action": {
    "default_title": "Tacet",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "store/icon16.png",
      "32": "store/icon32.png",
      "48": "store/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/rawAudioProcessor.js",
        "vendor/audioConcatProcessor.js",
        "vendor/libsamplerate.worklet.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
